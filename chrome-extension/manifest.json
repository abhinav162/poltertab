{
  "manifest_version": 3,
  "name": "PolterTab Browser Control",
  "version": "1.2.0",
  "description": "Let any AI assistant drive and scrape your existing Chrome profile — no headless browser, no complex setup.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "activeTab",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
